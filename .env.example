# Better Auth
# openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:43127
NEXT_PUBLIC_APP_URL=http://localhost:43127

# Cloudflare D1 HTTP API for Kingdom Financial only.
# Database ID from `wrangler d1 create kingdom-financial` or Cloudflare MCP.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_D1_DATABASE_ID=
